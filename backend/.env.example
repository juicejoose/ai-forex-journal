# Copy this file to backend/.env for a new installation, then replace placeholders.
# Keep an existing configured .env. Never put real credentials in this example.
OPENAI_API_KEY=replace_with_your_openai_api_key
# Matches the default in backend/main.py.
OPENAI_MODEL=gpt-6-luna
OANDA_API_TOKEN=replace_with_your_oanda_practice_api_token
OANDA_ACCOUNT_ID=replace_with_your_oanda_practice_account_id
# The current backend only accepts this practice URL.
OANDA_API_URL=https://api-fxpractice.oanda.com
